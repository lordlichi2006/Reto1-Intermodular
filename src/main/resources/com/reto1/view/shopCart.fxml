<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPanel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="" styleClass="mainPanel" stylesheets="@main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reto1.controller.ShopCartController">
    <top>
        <HBox fx:id="titleBar" onMouseDragged="#onDrag" onMousePressed="#onDragStart" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnHome" mnemonicParsing="false" onAction="#menuHome" styleClass="menuButton" stylesheets="@main.css" text="SHOP HOME" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnCart" disable="true" mnemonicParsing="false" onAction="#menuCart" styleClass="menuButton" stylesheets="@main.css" text="MY CART" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnDelivers" mnemonicParsing="false" onAction="#menuDeliveries" styleClass="menuButton" stylesheets="@main.css" text="DELIVERIES" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#menuProfile" styleClass="menuButton" stylesheets="@main.css" text="MY PROFILE" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="windowControls" stylesheets="@main.css" text="−" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#maximizeWindow" styleClass="windowControls" stylesheets="@main.css" text="❐" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="windowControls" stylesheets="@main.css" text="×" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tblCart" maxHeight="1.7976931348623157E308" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colName" prefWidth="180.0" text="Product" />
                <TableColumn fx:id="colBrand" prefWidth="130.0" text="Brand" />
                <TableColumn fx:id="colPrice" prefWidth="90.0" text="Price" />
                <TableColumn fx:id="colUnits" prefWidth="70.0" text="Units" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="Your cart is empty" />
            </placeholder>
            <BorderPane.margin>
                <Insets left="15.0" right="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <right>
        <VBox alignment="BOTTOM_RIGHT" prefWidth="150.0" spacing="10.0" BorderPane.alignment="BOTTOM_RIGHT">
            <children>
                <Button fx:id="btnRemoveItem" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" onAction="#removeFromCart" styleClass="uiButton" text="_Remove Item" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Label alignment="BOTTOM_LEFT" text="Amount:" textFill="WHITE" />
                        <Spinner fx:id="spnAmount" editable="true" initialValue="1" max="99" min="1" prefWidth="65.0" />
                    </children>
                </HBox>
                <Label text="Send to:" textFill="WHITE" />
                <ComboBox fx:id="cmbAddress" maxWidth="1.7976931348623157E308" promptText="Address" />
                <Label fx:id="lblTotal" text="Total: 0.00 €" textFill="WHITE" />
                <Button fx:id="btnPurchase" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" onAction="#purchase" styleClass="uiButton" text="_Purchase" />
            </children>
            <padding>
                <Insets right="15.0" />
            </padding>
        </VBox>
    </right>
    <bottom>
        <Label fx:id="lblError" styleClass="errorText" BorderPane.alignment="CENTER">
            <font>
                <Font name="Consolas" size="12.0" />
            </font>
            <padding>
                <Insets bottom="5.0" top="5.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
