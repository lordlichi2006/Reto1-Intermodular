<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPanel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="" styleClass="mainPanel" stylesheets="@main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reto1.controller.ShopHomeController">
    <top>
        <HBox fx:id="titleBar" onMouseDragged="#onDrag" onMousePressed="#onDragStart" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnHome" disable="true" mnemonicParsing="false" onAction="#menuHome" styleClass="menuButton" stylesheets="@main.css" text="SHOP HOME" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnCart" mnemonicParsing="false" onAction="#menuCart" styleClass="menuButton" stylesheets="@main.css" text="MY CART" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnDelivers" mnemonicParsing="false" onAction="#menuDeliveries" styleClass="menuButton" stylesheets="@main.css" text="DELIVERIES" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#menuProfile" styleClass="menuButton" stylesheets="@main.css" text="MY PROFILE" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="windowControls" stylesheets="@main.css" text="−" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#maximizeWindow" styleClass="windowControls" stylesheets="@main.css" text="❐" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="windowControls" stylesheets="@main.css" text="×" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </top>
   <center>
      <VBox alignment="BOTTOM_CENTER" spacing="10.0" BorderPane.alignment="BOTTOM_CENTER">
         <children>
            <TextField fx:id="txtSearchbox" onKeyTyped="#search" promptText="Search for products" styleClass="textField" />
            <TableView fx:id="tblProducts" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn prefWidth="75.0" text="C1" />
                <TableColumn prefWidth="75.0" text="C2" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets left="15.0" right="25.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <VBox alignment="BOTTOM_RIGHT" prefWidth="150.0" spacing="10.0" BorderPane.alignment="BOTTOM_RIGHT">
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Label alignment="BOTTOM_LEFT" text="Amount:" textFill="WHITE" />
                  <TextField prefWidth="30.0" styleClass="textField" text="1" />
               </children>
            </HBox>
            <Button alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" styleClass="uiButton" text="_Add To Cart" />
         </children>
         <padding>
            <Insets right="15.0" />
         </padding>
      </VBox>
   </right>
   <bottom>
      <Label styleClass="errorText" text="sample error" BorderPane.alignment="CENTER">
         <font>
            <Font name="Consolas" size="12.0" />
         </font>
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>
