<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPanel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="" styleClass="mainPanel" stylesheets="@main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reto1.controller.ShopProfileController">
    <top>
        <HBox fx:id="titleBar" onMouseDragged="#onDrag" onMousePressed="#onDragStart" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnHome" mnemonicParsing="false" onAction="#menuHome" styleClass="menuButton" stylesheets="@main.css" text="SHOP HOME" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnCart" mnemonicParsing="false" onAction="#menuCart" styleClass="menuButton" stylesheets="@main.css" text="MY CART" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnDelivers" mnemonicParsing="false" onAction="#menuDeliveries" styleClass="menuButton" stylesheets="@main.css" text="DELIVERIES" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnProfile" disable="true" mnemonicParsing="false" onAction="#menuProfile" styleClass="menuButton" stylesheets="@main.css" text="MY PROFILE" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="windowControls" stylesheets="@main.css" text="−" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#maximizeWindow" styleClass="windowControls" stylesheets="@main.css" text="❐" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="windowControls" stylesheets="@main.css" text="×" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="60.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="60.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" />
                    </columnConstraints>
                    <children>
                        <Label text="Name:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtName" styleClass="textField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Type:" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cmbType" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <Label text="Email:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtEmail" styleClass="textField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <Label text="Addresses:" textFill="WHITE" />
                <ListView fx:id="lstAddresses" VBox.vgrow="ALWAYS">
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem fx:id="menuAddAddress" mnemonicParsing="false" onAction="#addAddress" text="Add address" />
                                <MenuItem fx:id="menuRemoveAddress" mnemonicParsing="false" onAction="#removeAddress" text="Remove address" />
                            </items>
                        </ContextMenu>
                    </contextMenu>
                    <placeholder>
                        <Label text="No addresses saved" />
                    </placeholder>
                </ListView>
                <TextField fx:id="txtNewAddress" promptText="New address (right click on the list to add it)" styleClass="textField" />
            </children>
            <padding>
                <Insets left="15.0" right="25.0" top="10.0" />
            </padding>
        </VBox>
    </center>
    <right>
        <VBox alignment="BOTTOM_RIGHT" prefWidth="150.0" spacing="10.0" BorderPane.alignment="BOTTOM_RIGHT">
            <children>
                <Button fx:id="btnSave" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" onAction="#saveChanges" styleClass="uiButton" text="_Save Changes" />
                <Button fx:id="btnLogout" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" onAction="#logOut" styleClass="uiButton" text="_Log Out" />
            </children>
            <padding>
                <Insets right="15.0" />
            </padding>
        </VBox>
    </right>
    <bottom>
        <Label fx:id="lblError" styleClass="errorText" BorderPane.alignment="CENTER">
            <font>
                <Font name="Consolas" size="12.0" />
            </font>
            <padding>
                <Insets bottom="5.0" top="5.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
