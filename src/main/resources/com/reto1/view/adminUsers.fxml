<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPanel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="" styleClass="mainPanel" stylesheets="@main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reto1.controller.AdminUsersController">
    <top>
        <HBox fx:id="titleBar" onMouseDragged="#onDrag" onMousePressed="#onDragStart" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnShipments" mnemonicParsing="false" onAction="#adminMenuShipments" styleClass="menuButton" stylesheets="@main.css" text="SHIPMENTS" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnProducts" mnemonicParsing="false" onAction="#adminMenuProducts" styleClass="menuButton" stylesheets="@main.css" text="PRODUCTS" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnOffers" mnemonicParsing="false" onAction="#adminMenuOffers" styleClass="menuButton" stylesheets="@main.css" text="OFFERS" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnUsers" disable="true" mnemonicParsing="false" onAction="#adminMenuUsers" styleClass="menuButton" stylesheets="@main.css" text="USERS" textFill="WHITE">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnLog" mnemonicParsing="false" onAction="#adminMenuLog" styleClass="menuButton" stylesheets="@main.css" text="LOG" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#logOut" styleClass="menuButton" stylesheets="@main.css" text="LOGOUT" textFill="#cccccc">
                            <font>
                                <Font name="Cooper Black" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="windowControls" stylesheets="@main.css" text="−" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#maximizeWindow" styleClass="windowControls" stylesheets="@main.css" text="❐" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="windowControls" stylesheets="@main.css" text="×" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <HBox spacing="40.0">
            <children>
                <TableView fx:id="userTable" prefWidth="460.0" />
                <VBox spacing="30.0" HBox.hgrow="ALWAYS">
                    <children>
                    <GridPane hgap="15.0" vgap="22.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="200.0" />
                            <ColumnConstraints halignment="RIGHT" minWidth="90.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="200.0" />
                        </columnConstraints>
                        <children>
                            <Label styleClass="formLabel" text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="tfName" styleClass="formField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label styleClass="formLabel" text="Type" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <ComboBox fx:id="cmbType" maxWidth="1.7976931348623157E308" styleClass="formField" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Label styleClass="formLabel" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="tfEmail" styleClass="formField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label styleClass="formLabel" text="Role" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <ComboBox fx:id="cmbRole" maxWidth="1.7976931348623157E308" styleClass="formField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            <Label styleClass="formLabel" text="Password" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <PasswordField fx:id="pfPasswd" styleClass="formField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label styleClass="formLabel" text="Addresses" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <ListView fx:id="lstAddresses" prefHeight="120.0" GridPane.columnIndex="3" GridPane.rowIndex="2" GridPane.rowSpan="2">
                                <contextMenu>
                                    <ContextMenu>
                                        <items>
                                            <MenuItem mnemonicParsing="false" onAction="#removeAddress" text="Remove address" />
                                        </items>
                                    </ContextMenu>
                                </contextMenu>
                            </ListView>
                            <Label styleClass="formLabel" text="ID document" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="tfIdDocument" styleClass="formField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                    </GridPane>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Label styleClass="formLabel" text="New address" />
                            <TextField fx:id="tfNewAddress" promptText="Enter address" styleClass="formField" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAddAddress" mnemonicParsing="false" onAction="#addAddress" styleClass="actionButton" text="Add address" />
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="523.0" spacing="25.0">
                        <children>
                            <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#editUser" styleClass="actionButton" text="Edit user">
                           <HBox.margin>
                              <Insets left="105.0" />
                           </HBox.margin></Button>
                            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#deleteUser" styleClass="actionButton" text="Delete user" />
                            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#saveUser" styleClass="actionButton" text="Save changes" />
                        </children>
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </HBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
        </HBox>
    </center>
</BorderPane>
